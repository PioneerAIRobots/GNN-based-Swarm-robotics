<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>swarm_bringup</name>
  <version>1.0.0</version>
  <description>
    Top-level launch for OPERATION SENTINEL GRID: three platforms with full
    URDFs, the GNN coordination layer and the RViz mission display. No physics
    engine === the platforms are integrated kinematically by swarm_gnn.
  </description>
  <maintainer email="platformanalytics23@gmail.com">khan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>swarm_description</exec_depend>
  <exec_depend>swarm_gnn</exec_depend>
  <exec_depend>swarm_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
