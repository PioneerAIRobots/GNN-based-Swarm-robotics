<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>swarm_description</name>
  <version>1.0.0</version>
  <description>
    URDF/xacro descriptions for the SENTINEL GRID swarm: a quadrotor (RECON),
    a 4x4 skid-steer UGV (MULE) and a 12-DOF quadruped (HOUND), with the
    mission sensor suite each one carries. Visualised in RViz; motion and
    sensing are simulated by swarm_gnn.
  </description>
  <maintainer email="platformanalytics23@gmail.com">khan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
